# Application
PORT=3000

# x-api-key guard (leave blank to disable guard)
API_KEY=change-me-to-a-secret-key

# MongoDB
MONGODB_URI=mongodb://localhost:27017/stock-service

# Discord bot token (required for alert notifications)
DISCORD_BOT_TOKEN=your-bot-token-here

# Settings stored in MongoDB — configure via PUT /settings
# ┌──────────────────────────────────────┬─────────────────────────────────────────┬──────────────────────────┐
# │ Key                                  │ Description                             │ Default                  │
# ├──────────────────────────────────────┼─────────────────────────────────────────┼──────────────────────────┤
# │ stock.apiBaseUrl                     │ URL of the stock-alert FastAPI service  │ http://localhost:8000    │
# │ stock.apiSource                      │ Default data source                     │ KBS                      │
# │ stock.alertThresholdPercent          │ % change that triggers an alert         │ 3                        │
# │ discord.alertChannelId               │ Discord channel ID for price alerts     │ (required for alerts)    │
# └──────────────────────────────────────┴─────────────────────────────────────────┴──────────────────────────┘
